# AllWheel Control – Umgebungsvariablen
# Entwicklung: als backend/.env oder .env im Projektordner ablegen.
# Raspberry Pi: /etc/allwheel-control/allwheel.env (wird von install.sh angelegt, Rechte 0640).

# --- Zugang ---------------------------------------------------------------
# Fahrer-PIN (4–12 Ziffern). Leer lassen = beim ersten Start zufällig erzeugen (data/credentials.json).
AWC_DRIVER_PIN=
# Administrator-Passwort (mind. 8 Zeichen) ODER besser ein Hash:
#   cd backend && .venv/bin/python -m app.utils.hash_password
AWC_ADMIN_PASSWORD=
AWC_ADMIN_PASSWORD_HASH=
# Gültigkeit der Anmeldung in Stunden (1–168)
AWC_TOKEN_TTL_HOURS=12

# --- Netzwerk ---------------------------------------------------------------
AWC_HOST=0.0.0.0
AWC_PORT=8080
# Zusätzliche erlaubte Herkünfte für WebSocket-Verbindungen (kommagetrennt), z. B. Vite-Dev-Server.
# Gleiche Herkunft (Seite und WebSocket vom selben Host) ist immer erlaubt.
AWC_ALLOWED_ORIGINS=
# TLS (HTTPS/WSS) – nötig für die Neigungssteuerung. Zertifikat: deployment/scripts/generate-cert.sh
AWC_TLS_CERTFILE=
AWC_TLS_KEYFILE=
AWC_WIFI_INTERFACE=wlan0

# --- Pfade ------------------------------------------------------------------
# Standard (Entwicklung): backend/data bzw. frontend/dist
# AWC_DATA_DIR=/var/lib/allwheel-control
# AWC_FRONTEND_DIST=/opt/allwheel-control/frontend/dist

# --- Hardware ---------------------------------------------------------------
# Zweite, unabhängige Freigabe des Hardwaremodus. Nur auf 1 setzen, wenn die Checkliste in
# docs/hardware.md vollständig abgearbeitet ist. Ohne diese Variable startet nie Hardware.
AWC_HARDWARE_ENABLED=0

# --- Protokollierung ----------------------------------------------------------
AWC_LOG_LEVEL=INFO
